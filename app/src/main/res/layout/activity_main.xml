<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f3f4f6">

    <!-- center content, leave space top/bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        android:gravity="center">

        <!-- Card style helper: white card with subtle shadow -->
        <!-- Temperature and Humidity Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/tempHumidityCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="temp_icon"
                    android:src="@android:drawable/ic_menu_compass"
                    android:background="@drawable/icon_circle"
                    android:padding="8dp"
                    app:tint="#0369A1"
                    android:layout_marginEnd="12dp"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Temperature"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/temperatureTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--°C"
                        android:fontFamily="sans-serif"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginTop="4dp" />

                    <!-- Humidity (added back to match MainActivity expectations) -->
                    <TextView
                        android:id="@+id/humidityTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="6dp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Alcohol Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/alcoholCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="alcohol_icon"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:background="@drawable/icon_circle"
                    android:padding="8dp"
                    app:tint="#0369A1"
                    android:layout_marginEnd="12dp"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alcohol level"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/alcoholTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:fontFamily="sans-serif"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Ammonia Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/ammoniaCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="ammonia_icon"
                    android:src="@android:drawable/ic_menu_search"
                    android:background="@drawable/icon_circle"
                    android:padding="8dp"
                    app:tint="#0369A1"
                    android:layout_marginEnd="12dp"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ammonia level"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/ammoniaTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:fontFamily="sans-serif"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Weight Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/weightCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="weight_icon"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:background="@drawable/icon_circle"
                    android:padding="8dp"
                    app:tint="#0369A1"
                    android:layout_marginEnd="12dp"
                    android:scaleType="centerInside" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Weight"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="12sp"
                        android:textColor="#64748B" />

                    <TextView
                        android:id="@+id/weightTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-- g"
                        android:fontFamily="sans-serif"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/weightLossTextView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loss: --%"
                        android:fontFamily="sans-serif"
                        android:textSize="12sp"
                        android:textColor="#64748B"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Minimal progress indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
