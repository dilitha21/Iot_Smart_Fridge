<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Setting"
            android:textStyle="bold"
            android:textSize="22sp" />

        <!-- My Fridge Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Fridge"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:weightSum="3">

            <LinearLayout
                android:id="@+id/cardZone"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@android:color/white"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTemp"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@android:color/white"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Temperature" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardEnergy"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@android:color/white"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Energy" />
            </LinearLayout>
        </LinearLayout>

        <!-- My Account -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Account"
            android:textSize="16sp"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:layout_marginTop="8dp"
            android:padding="8dp">

            <TextView
                android:id="@+id/rowOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Orders"
                android:padding="8dp" />

            <TextView
                android:id="@+id/rowWallet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Wallet"
                android:padding="8dp" />

            <TextView
                android:id="@+id/rowUsers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Other Users"
                android:padding="8dp" />

            <TextView
                android:id="@+id/rowSupport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Customer Service"
                android:padding="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Log Out"
            android:textAllCaps="false"
            android:background="#00A8A8"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
